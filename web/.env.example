# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public traffic analytics configuration
# AhaFrame production default. Browser-visible; not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EWPR5QXGWJ

# Canonical production origin; preview/local values may differ
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing Validation Alpha ingest endpoint. The URL is not a secret, but the
# Next.js runtime proxies waitlist writes server-side so browser code does not
# depend on Supabase/CORS details.
AHAFRAME_WAITLIST_ENDPOINT=https://your-project.supabase.co/functions/v1/validation-ingest

# Server-only Supabase credential — DO NOT prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Codex Reset Radar — server only.
# Primary public source is Tibo (@thsottiaux) on X.
X_BEARER_TOKEN=replace_me
TIBO_X_USERNAME=thsottiaux
# Optional: avoids resolving the username on every monitor run.
TIBO_X_USER_ID=
# Vercel Cron automatically sends CRON_SECRET as a Bearer token when configured.
CRON_SECRET=replace_with_a_long_random_secret
# Optional override for compatible X API gateways/proxies.
X_API_BASE_URL=https://api.x.com/2

# Future Waffo integration (#14) — server only; not used during parity migration
WAFFO_MERCHANT_ID=replace_me
WAFFO_PRIVATE_KEY=replace_me
WAFFO_WEBHOOK_SECRET=replace_me
