# Public browser values. Never place service-role or payment secrets behind NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side Supabase foundation for future authenticated/account features.
SUPABASE_SERVICE_ROLE_KEY=

# Validation Alpha / product-feedback ingest endpoint. This should point at the
# Supabase validation-ingest Edge Function. The browser posts only to the
# same-origin /api/validation route; this endpoint remains server-side.
AHAFRAME_VALIDATION_ENDPOINT=

# Backward-compatible waitlist ingest endpoint. /api/validation falls back to
# this value when AHAFRAME_VALIDATION_ENDPOINT is not set, so existing Vercel
# production configuration continues to work during the cleanup migration.
AHAFRAME_WAITLIST_ENDPOINT=

# Exact release marker injected at build time by Vercel/GitHub release gates.
AHAFRAME_BUILD_COMMIT_SHA=
AHAFRAME_BUILD_COMMIT_REF=
AHAFRAME_BUILD_ENV=

# Search indexing is fail-closed. Only exact value 1 enables index/follow.
AHAFRAME_INDEXING_ENABLED=0
