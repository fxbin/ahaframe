{
  "name": "ahaframe-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "sync:runtime": "node scripts/sync-runtime-assets.mjs",
    "check:runtime": "node scripts/check-runtime-assets.mjs",
    "predev": "npm run sync:runtime && npm run check:runtime",
    "dev": "next dev",
    "check:routes": "node scripts/check-route-parity.mjs",
    "build": "npm run check:routes && npm run sync:runtime && npm run check:runtime && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.0.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.1.0"
  }
}
