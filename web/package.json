{
  "name": "ahaframe-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "write:build-mode": "node scripts/write-build-mode.mjs",
    "sync:runtime": "node scripts/sync-runtime-assets.mjs",
    "write:build-meta": "node scripts/write-build-meta.mjs",
    "check:runtime": "node scripts/check-runtime-assets.mjs",
    "check:experiences": "node scripts/check-runtime-experiences.mjs",
    "check:browser-secrets": "node scripts/check-browser-secrets.mjs",
    "prelint": "npm run write:build-mode",
    "lint": "eslint .",
    "pretypecheck": "npm run write:build-mode",
    "typecheck": "tsc --noEmit",
    "predev": "npm run write:build-mode && npm run sync:runtime && npm run check:runtime && npm run check:experiences",
    "dev": "next dev",
    "check:routes": "node scripts/check-route-parity.mjs",
    "prebuild": "npm run write:build-mode",
    "build": "npm run check:routes && npm run sync:runtime && npm run check:runtime && npm run check:experiences && npm run write:build-meta && next build",
    "start": "next start",
    "test:interaction": "playwright test --config=playwright.interaction.config.ts",
    "test:parity": "playwright test --config=playwright.parity.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.0.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.1.0"
  }
}
